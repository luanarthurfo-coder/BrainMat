rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Coleção de Usuários
    match /users/{userId} {
      // Qualquer visitante pode ler dados básicos de perfis para exibir no Ranking Global
      allow read: if true;

      // O usuário pode criar e atualizar seu próprio documento
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Validação de atualização de estatísticas pelo proprietário
      allow update: if request.auth != null 
                    && request.auth.uid == userId
                    // Garante que a data de criação não seja alterada
                    && request.resource.data.createdAt == resource.data.createdAt;

      // Bloqueia deleção direta pelo cliente por segurança
      allow delete: if false;
    }

    // Coleções futuras para escolas, turmas e conquistas
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
